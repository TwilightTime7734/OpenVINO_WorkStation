<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WorkStationC_</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="OpenVINO.CSharp.API\**\*.cs" />
    <Compile Remove="Extras\**\*.cs" />
    <Compile Remove="Checks\**" />
    <Compile Remove="_buildcheck\**\*.cs" />
    <EmbeddedResource Remove="OpenVINO.CSharp.API\**\*" />
    <EmbeddedResource Remove="Extras\**\*" />
    <EmbeddedResource Remove="Checks\**" />
    <EmbeddedResource Remove="_buildcheck\**\*" />
    <None Remove="OpenVINO.CSharp.API\**\*" />
    <None Remove="Extras\**\*" />
    <None Remove="Checks\**" />
    <None Remove="_buildcheck\**\*" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="WorkstationChecks" />
    <ProjectReference Include="OpenVINO.CSharp.API\OpenVINO.CSharp.API.csproj" />
    <PackageReference Include="OpenVINO.runtime.win" Version="2026.3.0" />
    <PackageReference Include="JYPPX.OpenVINO.GenAI.runtime.win" Version="2026.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Form1.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form1.Designer.cs">
      <DependentUpon>Form1.cs</DependentUpon>
      <SubType>Designer</SubType>
    </Compile>
    <EmbeddedResource Update="Form1.resx">
      <DependentUpon>Form1.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="ovms-settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ovms-settings.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="SearchApiKeys.txt" Condition="Exists('SearchApiKeys.txt')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
